{
  "$schema": "references/video-providers.schema.json",
  "version": 1,
  "routing": {
    "policy": "local-first",
    "max_attempts": 2,
    "fallback": "light-motion-local"
  },
  "providers": [
    {
      "id": "grok-build-local",
      "driver": "command",
      "provider": "grok-build",
      "model": "image_to_video",
      "enabled": true,
      "priority": 100,
      "command": ["python3", "/absolute/path/to/motion-sticker-pack/scripts/grok_build_video_adapter.py"],
      "credentials": {
        "env": [],
        "optional_env": [
          "GROK_BIN",
          "GROK_CONFIG_PATH",
          "GROK_HOME",
          "GROK_USE_XAI_API_KEY",
          "GROK_DEBUG_FILE",
          "GROK_LOG_FILE",
          "GROK_SANDBOX",
          "GROK_ZDR_ACCESS_ENABLED",
          "GROK_DISABLE_ZDR_INCOMPATIBLE_TOOLS",
          "RUST_LOG",
          "XAI_API_KEY"
        ]
      },
      "capabilities": ["image-to-video"]
    },
    {
      "id": "xai-direct",
      "driver": "command",
      "provider": "xai",
      "model": "grok-imagine-video",
      "enabled": true,
      "priority": 80,
      "command": ["python3", "/absolute/path/to/motion-sticker-pack/scripts/xai_rest_video_adapter.py"],
      "credentials": {
        "env": ["XAI_API_KEY"],
        "optional_env": [
          "XAI_VIDEO_UPLOAD_URL",
          "XAI_VIDEO_DOWNLOAD_URL",
          "XAI_VIDEO_LOCAL_OUTPUT_PATH",
          "XAI_VIDEO_REQUEST_ID"
        ]
      },
      "capabilities": ["image-to-video", "text-to-video", "video-edit"]
    },
    {
      "id": "kling-primary",
      "driver": "ai-sdk",
      "provider": "klingai",
      "package": "@ai-sdk/klingai",
      "model": "kling-v2.6-i2v",
      "region": "global",
      "enabled": false,
      "priority": 80,
      "credentials": {
        "env": ["KLINGAI_API_KEY"]
      },
      "provider_options": {
        "mode": "std"
      },
      "capabilities": ["image-to-video"]
    },
    {
      "id": "seedance-primary",
      "driver": "ai-sdk",
      "provider": "bytedance",
      "package": "@ai-sdk/bytedance",
      "model": "seedance-1-5-pro-251215",
      "region": "international",
      "enabled": false,
      "priority": 70,
      "credentials": {
        "env": ["ARK_API_KEY"]
      },
      "provider_options": {
        "cameraFixed": true,
        "generateAudio": false,
        "watermark": false
      },
      "capabilities": ["image-to-video", "first-last-frame"]
    },
    {
      "id": "wan-primary",
      "driver": "ai-sdk",
      "provider": "alibaba",
      "package": "@ai-sdk/alibaba",
      "model": "wan2.6-i2v-flash",
      "region": "international",
      "enabled": false,
      "priority": 68,
      "credentials": {
        "env": ["DASHSCOPE_API_KEY"]
      },
      "provider_options": {
        "audio": false,
        "promptExtend": true,
        "shotType": "single",
        "watermark": false
      },
      "capabilities": ["image-to-video"]
    },
    {
      "id": "grok-primary",
      "driver": "ai-sdk",
      "provider": "xai",
      "package": "@ai-sdk/xai",
      "model": "grok-imagine-video",
      "region": "global",
      "enabled": false,
      "priority": 65,
      "credentials": {
        "env": ["XAI_API_KEY"]
      },
      "capabilities": ["image-to-video", "text-to-video", "video-edit"]
    },
    {
      "id": "fal-fallback",
      "driver": "ai-sdk",
      "provider": "fal",
      "package": "@ai-sdk/fal",
      "model": "luma-dream-machine/ray-2/image-to-video",
      "region": "global",
      "enabled": false,
      "priority": 60,
      "credentials": {
        "env": ["FAL_API_KEY"]
      },
      "provider_options": {
        "loop": true
      },
      "capabilities": ["image-to-video"]
    },
    {
      "id": "custom-relay",
      "driver": "command",
      "provider": "custom",
      "model": "configured-by-adapter",
      "enabled": false,
      "priority": 50,
      "command": ["node", "/absolute/path/to/video-relay-adapter.mjs"],
      "credentials": {
        "env": ["VIDEO_RELAY_API_KEY"]
      },
      "capabilities": ["image-to-video"]
    }
  ]
}
