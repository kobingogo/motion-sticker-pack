{
  "$schema": "../references/video-task.schema.json",
  "version": 1,
  "operation": "image-to-video",
  "required_capabilities": ["image-to-video"],
  "prefer_capabilities": ["first-last-frame"],
  "require_alpha": false,
  "allow_key_background": true,
  "key_color": "#00FF00",
  "safe_grid_scale": 0.80,
  "min_guard_fraction": 0.10,
  "max_foreground_bbox_fraction": 0.80,
  "motion_active_seconds": 2.0,
  "loop_min_seconds": 1.5,
  "loop_max_seconds": 2.5,
  "allow_fallback": false,
  "provider": "grok-build-local",
  "input_image": "/absolute/path/to/static-sheet.png",
  "layout_file": "/absolute/path/to/layout.json",
  "prompt_file": "/absolute/path/to/prompts.json",
  "approval_file": "/absolute/path/to/job-state.json",
  "output_directory": "/absolute/path/to/raw-video",
  "duration_seconds": 6,
  "provider_duration_seconds": {
    "grok-build-local": 6,
    "xai-direct": 3
  },
  "production_settings_file": "/absolute/path/to/sticker-production.json",
  "timeout_seconds": 900,
  "poll_interval_ms": 5000,
  "max_retries": 0,
  "max_output_bytes": 209715200
}
